{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "flask-api": {
      "root": "flask_video_downloader",
      "framework": "flask",
      "installCommand": "pip install -r requirements.txt",
      "functions": {
        "app.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/get-video",
      "destination": {
        "service": "flask-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "flask-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}