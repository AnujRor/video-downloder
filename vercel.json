{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "express-api": {
      "root": ".",
      "framework": "node",
      "entrypoint": "server.ts",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "flask-api": {
      "root": "flask_video_downloader",
      "framework": "flask",
      "installCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/get-video",
      "destination": {
        "service": "express-api"
      }
    },
    {
      "source": "/api/flask/(.*)",
      "destination": {
        "service": "flask-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}